DATABASE_URL="postgresql://ksmile:ksmile@localhost:5439/ksmile?schema=public"

# Auth
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"
# URL publique du site (prod), ex. https://ksmile.cm
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Compte admin (créé / mis à jour par: npm run db:seed)
ADMIN_EMAIL="admin@ksmile.cm"
ADMIN_PASSWORD="change-me"

# Cloudinary (mêmes valeurs en local et prod)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_FOLDER="ksmile"

# Backups (service docker compose « backup »)
CLOUDINARY_BACKUP_FOLDER="ksmile/backups"
BACKUP_KEEP_DAYS="14"
