# Copier vers .env sur le VPS puis adapter

POSTGRES_USER=ksmile
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=ksmile
APP_PORT=3000

AUTH_SECRET=change-me-long-random-secret
AUTH_TRUST_HOST=true
# Domaine public HTTPS (après reverse proxy)
AUTH_URL=https://TON-DOMAINE
NEXT_PUBLIC_SITE_URL=https://TON-DOMAINE

ADMIN_EMAIL=admin@ksmile.cm
ADMIN_PASSWORD=change-me-strong-admin-password

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=ksmile

# Backups Postgres → Cloudinary (tous les soirs 23:00 Africa/Douala)
CLOUDINARY_BACKUP_FOLDER=ksmile/backups
BACKUP_KEEP_DAYS=14

# false en prod : pas de produits de démo.
# L’admin est toujours créé/mis à jour via ADMIN_EMAIL / ADMIN_PASSWORD.
# true seulement si tu veux charger le catalogue de démo une fois.
RUN_SEED=false
